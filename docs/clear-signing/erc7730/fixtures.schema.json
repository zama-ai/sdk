{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zama.ai/sdk/clear-signing/erc7730-fixtures.schema.json",
  "title": "Zama SDK ERC-7730 local fixtures",
  "type": "object",
  "required": ["chainId", "accounts", "contracts", "values", "calldata", "eip712"],
  "properties": {
    "chainId": {
      "type": "integer"
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "values": {
      "type": "object"
    },
    "calldata": {
      "type": "array"
    },
    "eip712": {
      "type": "array"
    }
  }
}
