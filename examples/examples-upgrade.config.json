      "packageManager": "npm",
      "sdkPackages": ["@zama-fhe/sdk", "@zama-fhe/react-sdk"],
      "validation": {
        "install": ["npm ci"],
        "checks": ["npm run typecheck", "npm run build", "npm run test:e2e"],
        "playwrightInstall": "npx playwright install --with-deps chromium"
      },
      "notes": [
        "Dedicated CI workflow runs npm ci and npm run test:e2e from this app directory.",
        "Uses RelayerCleartext and Hoodi-specific config."
      ]
    },
