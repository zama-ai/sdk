direction: right

title: {
  label: "@zama-fhe/sdk Module Map"
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# --- Modules ---
token: "token/" {
  zama-sdk: "ZamaSDK\n(factory)"
  tok: "Token\n(read + base writes)"
  wrapped: "WrappedToken\n(extends Token —\nshield/unshield)"
  creds: "Permits\n(CredentialService)"
  cache: "BalanceCache"

  zama-sdk -> tok: createToken
  zama-sdk -> wrapped: createWrappedToken
  wrapped -> tok: extends
  tok -> creds: requests permits
  tok -> cache: caches balances
}

query: "query/" {
  keys: "zamaQueryKeys\n(key factory)"
  opts: "queryOptions\n(read factories)"
  mutations: "mutationOptions\n(write factories)"
  invalidation: "invalidation\n(cache helpers)"

  opts -> keys: uses
  mutations -> keys: uses
  invalidation -> keys: uses
}

contracts: "contracts/" {
  erc20: "ERC-20 builders"
  wrapper: "Wrapper builders"
  encryption: "Encryption builders"
  fee: "Fee builders"
  batcher: "Transfer batcher"
  erc165: "Interface detection"
  coordinator: "Deployment coordinator"
}

relayer: "relayer/ + transports" {
  fhevm: "FhevmRelayer\n(drives @fhevm/sdk)"
  web: "web()\n(browser)"
  node: "node()\n(server)"
  cleartext: "cleartext()\n(testing)"
}

fhevmsdk: "@fhevm/sdk\n(FHE backend)" {
  browser: "Web Worker + WASM\n(browser)"
  nodepool: "worker_threads\n(Node.js)"
}

events: "events/" {
  sdk-events: "ZamaSDKEvents"
  onchain: "On-chain decoders"
}

abi: "abi/" {
  label: "ABI definitions\n(pure data)"
  style.fill: "#ECEFF1"
}

storage: "storage/" {
  indexeddb: "IndexedDBStorage"
  memory: "MemoryStorage"
  async-local: "AsyncLocalStorage"
  chrome: "ChromeSessionStorage"
}

signers: "viem/ · ethers/" {
  viem-signer: "ViemSigner"
  ethers-signer: "EthersSigner"
}

# --- Dependencies ---
query -> token: "wraps SDK calls"
token -> relayer: "encrypt/decrypt"
token -> events: "emit events"
contracts -> abi: "ABI constants"
relayer -> fhevmsdk: "FHE operations"
signers -> relayer: "Address/Hex types"
signers -> contracts: "BatchTransferData"
token -> storage: "credential persistence"
