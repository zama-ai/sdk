# Dynamic wallet connection (https://app.dynamic.xyz). When set, "Connect Wallet" opens a
# connect dialog listing Dynamic's wallet catalogue (browser wallets + WalletConnect — how a
# Safe pairs from the Safe web app), and the page CSP admits Dynamic's API and WalletConnect's
# relay. When unset, the app uses wagmi's injected connector only.
# NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Custom Zama environment on Sepolia (another protocol deployment on the same chain, for
# example a pre-release one). Swaps the Sepolia row's protocol contracts and gateway for the
# values below; its relayer is SEPOLIA_RELAYER_URL. All required when set to "custom".
# NEXT_PUBLIC_ZAMA_ENV=custom
# NEXT_PUBLIC_ZAMA_GATEWAY_CHAIN_ID=0
# NEXT_PUBLIC_ZAMA_ACL_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_KMS_VERIFIER_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_INPUT_VERIFIER_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_DECRYPTION_ADDRESS=0x...            # gateway Decryption contract (EIP-712)
# NEXT_PUBLIC_ZAMA_INPUT_VERIFICATION_ADDRESS=0x...    # gateway InputVerification contract (EIP-712)
# Optional: ProtocolConfig contract, needed for unified (V2) decryption permits.
# NEXT_PUBLIC_ZAMA_PROTOCOL_CONFIG_ADDRESS=0x...
# Wrapper registry of the custom environment (a ConfidentialTokenWrappersRegistry you deployed).
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...

# Relayer upstreams (server-side only, read by the proxy). Bare hosts, no /v2 suffix.
# Testnets default to the public relayer, which needs no key.
# SEPOLIA_RELAYER_URL=https://relayer.testnet.zama.org
# SEPOLIA_RELAYER_API_KEY=

# Mainnets are hidden until a relayer URL is set. See README "Mainnet access".
# MAINNET_RELAYER_URL=https://relayer.mainnet.zama.org
# MAINNET_RELAYER_API_KEY=
# POLYGON_RELAYER_URL=https://relayer.mainnet.zama.org
# POLYGON_RELAYER_API_KEY=

# Comma-separated origins allowed to call the proxy. Replaces the default (the app's own
# origin), so list that too.
# RELAYER_PROXY_ALLOWED_ORIGINS=

# Hosting only. See README "Hosting". Nothing here is needed to run the app locally.
# Hide networks: when set, only these table keys are offered and proxied. Unset (the default)
# offers every network the server can serve, including the cleartext dev chains.
# ENABLED_NETWORKS=mainnet,sepolia
# Where the browser downloads the FHE public key and CRS from: the origin of the URLs each
# relayer's /v2/keyurl returns. The public testnet relayer's bucket is built in; required for
# any other relayer (mainnet, self-hosted), or the page CSP blocks every encryption. Each
# entry must be an origin (scheme://host[:port]), checked at boot. The mainnet relayer needs
# the key: `curl -H "x-api-key: $MAINNET_RELAYER_API_KEY" https://relayer.mainnet.zama.org/v2/keyurl`
# CSP_CONNECT_SRC=
# Footer links. The commit falls back to Vercel's VERCEL_GIT_COMMIT_SHA.
# NEXT_PUBLIC_COMMIT_SHA=
# NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/zama-ai/sdk

# Optional RPC overrides (public endpoints by default).
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_BNB_TESTNET_RPC_URL=
# NEXT_PUBLIC_HOODI_RPC_URL=
# NEXT_PUBLIC_ZENITH_RPC_URL=
# NEXT_PUBLIC_MAINNET_RPC_URL=
# NEXT_PUBLIC_POLYGON_RPC_URL=

# Confidential vault on Sepolia for the Vaults tab: its deposit and redeem batchers. The tab
# shows a setup hint until both are set. FROM_BLOCK is the block the batchers were deployed
# at: the batch list reads their events from there, and public RPCs often cap that range.
# NEXT_PUBLIC_VAULT_DEPOSIT_BATCHER=0x...
# NEXT_PUBLIC_VAULT_REDEEM_BATCHER=0x...
# NEXT_PUBLIC_VAULT_FROM_BLOCK=
