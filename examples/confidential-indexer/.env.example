# Upstream Ethereum RPC URL (required) — needs eth_getLogs support with a
# reasonable block-range cap; some public nodes restrict this heavily.
INDEXER_RPC_URL=https://sepolia.drpc.org

# Chain ID — only Sepolia (11155111) is wired in this POC
INDEXER_CHAIN_ID=11155111

# HTTP server bind address / port
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8787

# This service's operational (delegate) identity — REAL custody, unlike
# zama-json-rpc's accountless design. Keep this out of source control and
# out of logs. See WALKTHROUGH.md ("custody model").
INDEXER_OPERATIONAL_PRIVATE_KEY=0x...

# Zama relayer API key — optional on Sepolia testnet
# INDEXER_RELAYER_API_KEY=

# Shared-secret bearer token required to query this service's API.
# Without it, anyone who can reach this service can read anything it has
# decrypted — fine for local exploration only. See WALKTHROUGH.md.
# INDEXER_API_KEY=

# Block to start delegation-log scanning from (required — scanning from
# genesis is impractical). Use a recent block number.
INDEXER_FROM_BLOCK=11200000

# Polling interval, in milliseconds, for delegation/balance/transfer scans.
# INDEXER_POLL_INTERVAL_MS=60000

# INDEXER_VERBOSE=true
# INDEXER_QUIET=true
