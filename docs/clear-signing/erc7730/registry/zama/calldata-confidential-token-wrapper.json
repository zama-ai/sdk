{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "Zama conf. wrapper",
    "contract": {
      "deployments": [
        {
          "chainId": 11155111,
          "address": "0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639"
        },
        {
          "chainId": 11155111,
          "address": "0x4E7B06D78965594eB5EF5414c357ca21E1554491"
        },
        {
          "chainId": 11155111,
          "address": "0x46208622DA27d91db4f0393733C8BA082ed83158"
        },
        {
          "chainId": 11155111,
          "address": "0xaa5612FA27c927a0c7961f5AEFEE5ba3A0F9C891"
        },
        {
          "chainId": 11155111,
          "address": "0xf2D628d2598aF4eAF94CB76a437Ff86CA78FfbFB"
        },
        {
          "chainId": 11155111,
          "address": "0xfCE5c7069c5525eF6c8C2b2E35A745bA20a2F7CC"
        },
        {
          "chainId": 11155111,
          "address": "0xe4FcF848739845BC81Dee1d5352cf3844F0a60C7"
        },
        {
          "chainId": 11155111,
          "address": "0x167DC962808B32CFFFc7e14B5018c0bE06A3A208"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Zama",
    "contractName": "Zama Confidential Token Wrapper",
    "info": {
      "url": "https://www.zama.ai/"
    }
  },
  "display": {
    "formats": {
      "wrap(address to,uint256 amount)": {
        "intent": "Shield public tokens",
        "interpolatedIntent": "Shield {amount} to {to}",
        "fields": [
          {
            "path": "#.amount",
            "label": "Amount",
            "format": "raw"
          },
          {
            "path": "#.to",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          }
        ]
      },
      "confidentialTransfer(address to,bytes32 encryptedAmount,bytes inputProof)": {
        "intent": "Send confidential tokens",
        "interpolatedIntent": "Send encrypted to {to}",
        "fields": [
          {
            "path": "#.to",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.encryptedAmount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            },
            "encryption": {
              "scheme": "fhevm",
              "plaintextType": "uint64",
              "fallbackLabel": "[Encrypted confidential amount]"
            }
          },
          {
            "path": "#.inputProof",
            "label": "Input proof",
            "format": "raw",
            "visible": "never"
          }
        ]
      },
      "unwrap(address from,address to,bytes32 encryptedAmount,bytes inputProof)": {
        "intent": "Request unshield",
        "interpolatedIntent": "Request unshield to {to}",
        "fields": [
          {
            "path": "#.from",
            "label": "From",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.to",
            "label": "Public recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.encryptedAmount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            },
            "encryption": {
              "scheme": "fhevm",
              "plaintextType": "uint64",
              "fallbackLabel": "[Encrypted unshield amount]"
            }
          },
          {
            "path": "#.inputProof",
            "label": "Input proof",
            "format": "raw",
            "visible": "never"
          }
        ]
      },
      "unwrap(address from,address to,bytes32 amount)": {
        "intent": "Request full-balance unshield",
        "interpolatedIntent": "Unshield full balance",
        "fields": [
          {
            "path": "#.from",
            "label": "From",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.to",
            "label": "Public recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.amount",
            "label": "Balance handle",
            "format": "raw",
            "encryption": {
              "scheme": "fhevm",
              "plaintextType": "uint64",
              "fallbackLabel": "[Encrypted full balance]"
            }
          }
        ]
      },
      "finalizeUnwrap(bytes32 unwrapRequestId,uint64 burntAmountCleartext,bytes decryptionProof)": {
        "intent": "Finalize unshield",
        "interpolatedIntent": "Finalize unshield",
        "fields": [
          {
            "path": "#.burntAmountCleartext",
            "label": "Clear amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "#.unwrapRequestId",
            "label": "Unshield request",
            "format": "raw",
            "visible": "optional"
          },
          {
            "path": "#.decryptionProof",
            "label": "Decryption proof",
            "format": "raw",
            "visible": "never"
          }
        ]
      }
    }
  }
}
