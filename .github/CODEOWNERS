/.trivyignore* @zama-ai/infosec
/trivy.yaml @zama-ai/infosec

# The daemon image and the workflows that build, scan and publish it, so the gate can't be weakened without a review.
/packages/sdk-daemon/Dockerfile* @zama-ai/infosec
/.github/workflows/daemon.yml @zama-ai/infosec
/.github/workflows/release.yml @zama-ai/infosec
/.github/workflows/daemon-image-scan.yml @zama-ai/infosec
