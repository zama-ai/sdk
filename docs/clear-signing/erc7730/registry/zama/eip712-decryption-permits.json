{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "Zama decrypt permits",
    "eip712": {
      "domain": {
        "name": "Decryption",
        "version": "1"
      },
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0f6024a97684f7d90ddb0fAAD79cB15F2C888D24"
        },
        {
          "chainId": 11155111,
          "address": "0x5D8BD78e2ea6bbE41f26dFe9fdaEAa349e077478"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Zama",
    "contractName": "Zama Decryption Verifier",
    "info": {
      "url": "https://www.zama.ai/"
    }
  },
  "display": {
    "formats": {
      "UserDecryptRequestVerification(bytes publicKey,address[] contractAddresses,uint256 startTimestamp,uint256 durationDays,bytes extraData)": {
        "intent": "Decrypt access",
        "interpolatedIntent": "Authorize decrypt access",
        "fields": [
          {
            "path": "#.publicKey",
            "label": "FHE public key",
            "format": "raw",
            "visible": "never"
          },
          {
            "path": "#.contractAddresses.[]",
            "label": "Conf. contract",
            "format": "addressName",
            "params": {
              "types": ["contract"]
            },
            "separator": "Contract {index}"
          },
          {
            "path": "#.startTimestamp",
            "label": "Starts",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "path": "#.durationDays",
            "label": "Duration",
            "format": "unit",
            "params": {
              "base": "d",
              "decimals": 0
            }
          },
          {
            "path": "#.extraData",
            "label": "Protocol data",
            "format": "raw",
            "visible": "never"
          }
        ]
      },
      "DelegatedUserDecryptRequestVerification(bytes publicKey,address[] contractAddresses,address delegatorAddress,uint256 startTimestamp,uint256 durationDays,bytes extraData)": {
        "intent": "Delegated decrypt",
        "interpolatedIntent": "Authorize delegated decrypt",
        "fields": [
          {
            "path": "#.publicKey",
            "label": "FHE public key",
            "format": "raw",
            "visible": "never"
          },
          {
            "path": "#.delegatorAddress",
            "label": "Delegator wallet",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "#.contractAddresses.[]",
            "label": "Conf. contract",
            "format": "addressName",
            "params": {
              "types": ["contract"]
            },
            "separator": "Contract {index}"
          },
          {
            "path": "#.startTimestamp",
            "label": "Starts",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "path": "#.durationDays",
            "label": "Duration",
            "format": "unit",
            "params": {
              "base": "d",
              "decimals": 0
            }
          },
          {
            "path": "#.extraData",
            "label": "Protocol data",
            "format": "raw",
            "visible": "never"
          }
        ]
      }
    }
  }
