# Relayer upstreams (server-side only, read by the proxy). Bare hosts, no /v2 suffix.
# Testnets default to the public relayer, which needs no key.
# SEPOLIA_RELAYER_URL=https://relayer.testnet.zama.org
# SEPOLIA_RELAYER_API_KEY=
# POLYGON_AMOY_RELAYER_URL=https://relayer.testnet.zama.org
# POLYGON_AMOY_RELAYER_API_KEY=

# Mainnets are hidden until a relayer URL is set. See README "Mainnet access".
# MAINNET_RELAYER_URL=https://relayer.mainnet.zama.org
# MAINNET_RELAYER_API_KEY=
# POLYGON_RELAYER_URL=https://relayer.mainnet.zama.org
# POLYGON_RELAYER_API_KEY=

# Comma-separated origins allowed to call the proxy. Defaults to the app's own origin.
# RELAYER_PROXY_ALLOWED_ORIGINS=

# Hosting only. See README "Hosting". Nothing here is needed to run the app locally.
# Hide networks: when set, only these table keys are offered and proxied. Unset (the default)
# offers every network the server can serve, including the cleartext dev chains.
# ENABLED_NETWORKS=mainnet,sepolia
# Extra origins for the page CSP connect-src: the key storage each relayer's keyurl names,
# used when encryption runs in the page instead of the encrypt worker. Find it with
# `curl <relayer url>/v2/keyurl` and set the origin of the URLs it returns.
# CSP_CONNECT_SRC=
# Footer links. The commit falls back to Vercel's VERCEL_GIT_COMMIT_SHA.
# NEXT_PUBLIC_COMMIT_SHA=
# NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/zama-ai/sdk

# Optional RPC overrides (public endpoints by default).
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=
# NEXT_PUBLIC_BNB_TESTNET_RPC_URL=
# NEXT_PUBLIC_HOODI_RPC_URL=
# NEXT_PUBLIC_ZENITH_RPC_URL=
# NEXT_PUBLIC_MAINNET_RPC_URL=
# NEXT_PUBLIC_POLYGON_RPC_URL=

# ConfidentialVault demo on Sepolia (confidentialTransferAndCall).
# NEXT_PUBLIC_VAULT_ADDRESS=
# NEXT_PUBLIC_VAULT_CONFIDENTIAL_TOKEN=
