{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "tsconfig.base.json", "tsconfig.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "api-report": { "dependsOn": ["build"], "outputs": ["etc/**"] },
    "api-report:check": { "dependsOn": ["build"], "outputs": [] },
    "//#size": {
      "dependsOn": ["@zama-fhe/sdk#build", "@zama-fhe/react-sdk#build"],
      "inputs": [".size-limit.json", "packages/sdk/dist/**", "packages/react-sdk/dist/**"],
      "outputs": []
    }
  }
}
