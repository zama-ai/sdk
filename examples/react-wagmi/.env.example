# Zama environment — "testnet" (default) or "custom". Both run on Sepolia (chain ID 11155111).
# "custom" points the app at another Zama environment on Sepolia (for example a pre-release
# one) described by the NEXT_PUBLIC_ZAMA_* variables below. See src/lib/config.ts.
# NEXT_PUBLIC_ZAMA_ENV=custom

# Custom environment (all required when NEXT_PUBLIC_ZAMA_ENV=custom, ignored otherwise).
# NEXT_PUBLIC_ZAMA_RELAYER_URL=https://relayer.example.com
# NEXT_PUBLIC_ZAMA_GATEWAY_CHAIN_ID=0
# NEXT_PUBLIC_ZAMA_ACL_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_KMS_VERIFIER_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_INPUT_VERIFIER_ADDRESS=0x...
# NEXT_PUBLIC_ZAMA_DECRYPTION_ADDRESS=0x...            # gateway Decryption contract (EIP-712)
# NEXT_PUBLIC_ZAMA_INPUT_VERIFICATION_ADDRESS=0x...    # gateway InputVerification contract (EIP-712)
# Optional: ProtocolConfig contract, needed for unified (V2) decryption permits.
# NEXT_PUBLIC_ZAMA_PROTOCOL_CONFIG_ADDRESS=0x...

# Wrapper registry override. Required on a custom environment without a registry deployment,
# pointing at a ConfidentialTokenWrappersRegistry you deployed there yourself.
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...

# Privy wallet login (https://dashboard.privy.io). When set, the "Connect Wallet" button opens
# Privy's wallet modal (injected wallets + WalletConnect — how a Gnosis Safe pairs from the
# Safe web app). When unset, the app falls back to wagmi's injected connector.
# NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Relayer — server-side (not exposed to the browser)
# Defaults to the relayer of the selected environment — no API key required for testnet.
# Bare relayer host, no /v2 suffix.
# RELAYER_URL=https://relayer.testnet.zama.org
# RELAYER_API_KEY=your_api_key_here

# Optional: override the default Sepolia RPC (https://ethereum-sepolia-rpc.publicnode.com)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Optional: ConfidentialVault demo (confidentialTransferAndCall). Defaults point at a vault
# deployed on Sepolia testnet bound to cUSDC. Override to use your own deployment
# (contracts/script/DeployVault.s.sol). The vault cards only render when the bound token is selected.
# NEXT_PUBLIC_VAULT_ADDRESS=0xb13720bec167A576D715F5aA7C7d68b3dB0A4Ad7
# NEXT_PUBLIC_VAULT_CONFIDENTIAL_TOKEN=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639
