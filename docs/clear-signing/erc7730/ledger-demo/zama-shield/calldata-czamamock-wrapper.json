          {
            "value": "0xf2D628d2598aF4eAF94CB76a437Ff86CA78FfbFB",
            "label": "Receive",
            "format": "tokenTicker",
            "params": {
              "chainId": 11155111
            }
          },
          {
            "path": "#.to",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa"]
            }
          },
          {
            "path": "@.to",
            "label": "Wrapper",
            "format": "addressName",
            "params": {
              "types": ["contract"]
            }
          },
          {
            "value": "Sepolia",
            "label": "Network",
            "format": "raw"
          }
        ]
      }
    }
  }
