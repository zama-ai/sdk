# Relayer (server-side, not exposed to the browser)
# Defaults to the public Zama testnet relayer when unset. That relayer is keyless:
# no API key is required for Polygon Amoy or any other testnet.
# Bare relayer host, no /v2 suffix.
# RELAYER_URL=https://relayer.testnet.zama.org
# RELAYER_API_KEY=your_api_key_here

# Optional: override the default Polygon Amoy RPC URL
# (https://polygon-amoy-bor-rpc.publicnode.com)
# Alchemy example: https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_AMOY_RPC_URL=
