{
  "name": "@zama-fhe/sdk",
  "version": "3.4.0-alpha.1",
  "description": "TypeScript SDK for Zama fhEVM confidential smart contracts",
  "keywords": [
    "blockchain",
    "confidential",
    "erc20",
    "ethereum",
    "fhe",
    "fhevm",
    "homomorphic-encryption",
    "privacy",
    "token",
    "zama"
  ],
  "homepage": "https://github.com/zama-ai/sdk#readme",
  "bugs": {
    "url": "https://github.com/zama-ai/sdk/issues"
  },
  "license": "BSD-3-Clause-Clear",
  "author": "Zama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/sdk.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "cleartext": [
        "./dist/esm/cleartext/index.d.ts"
      ],
      "query": [
        "./dist/esm/query/index.d.ts"
      ],
      "viem": [
        "./dist/esm/viem/index.d.ts"
      ],
      "ethers": [
        "./dist/esm/ethers/index.d.ts"
      ],
      "web": [
        "./dist/esm/web/index.d.ts"
      ],
      "node": [
        "./dist/esm/node/index.d.ts"
      ],
      "chains": [
        "./dist/esm/chains/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm/index.js"
    },
    "./cleartext": {
      "import": {
        "types": "./dist/esm/cleartext/index.d.ts",
        "default": "./dist/esm/cleartext/index.js"
      },
      "require": {
        "types": "./dist/esm/cleartext/index.d.ts",
        "default": "./dist/cjs/cleartext/index.cjs"
      },
      "default": "./dist/esm/cleartext/index.js"
    },
    "./query": {
      "import": {
        "types": "./dist/esm/query/index.d.ts",
        "default": "./dist/esm/query/index.js"
      },
      "require": {
        "types": "./dist/esm/query/index.d.ts",
        "default": "./dist/cjs/query/index.cjs"
      },
      "default": "./dist/esm/query/index.js"
    },
    "./viem": {
      "import": {
        "types": "./dist/esm/viem/index.d.ts",
        "default": "./dist/esm/viem/index.js"
      },
      "require": {
        "types": "./dist/esm/viem/index.d.ts",
        "default": "./dist/cjs/viem/index.cjs"
      },
      "default": "./dist/esm/viem/index.js"
    },
    "./ethers": {
      "import": {
        "types": "./dist/esm/ethers/index.d.ts",
        "default": "./dist/esm/ethers/index.js"
      },
      "require": {
        "types": "./dist/esm/ethers/index.d.ts",
        "default": "./dist/cjs/ethers/index.cjs"
      },
      "default": "./dist/esm/ethers/index.js"
    },
    "./web": {
      "import": {
        "types": "./dist/esm/web/index.d.ts",
        "default": "./dist/esm/web/index.js"
      },
      "require": {
        "types": "./dist/esm/web/index.d.ts",
        "default": "./dist/cjs/web/index.cjs"
      },
      "default": "./dist/esm/web/index.js"
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/cjs/node/index.cjs"
      },
      "default": "./dist/esm/node/index.js"
    },
    "./chains": {
      "import": {
        "types": "./dist/esm/chains/index.d.ts",
        "default": "./dist/esm/chains/index.js"
      },
      "require": {
        "types": "./dist/esm/chains/index.d.ts",
        "default": "./dist/cjs/chains/index.cjs"
      },
      "default": "./dist/esm/chains/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && rolldown --config rolldown.config.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "api-report": "api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.web.json && api-extractor run --local -c api-extractor.viem.json && api-extractor run --local -c api-extractor.ethers.json && api-extractor run --local -c api-extractor.node.json && api-extractor run --local -c api-extractor.query.json",
    "api-report:check": "api-extractor run -c api-extractor.json && api-extractor run -c api-extractor.web.json && api-extractor run -c api-extractor.viem.json && api-extractor run -c api-extractor.ethers.json && api-extractor run -c api-extractor.node.json && api-extractor run -c api-extractor.query.json"
  },
  "dependencies": {
    "@fhevm/sdk": "1.1.0-alpha.8",
    "viem": ">=2",
    "zod": ">=4"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.101.0"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5",
    "ethers": ">=6",
    "viem": ">=2"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
