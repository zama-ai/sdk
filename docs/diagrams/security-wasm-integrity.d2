direction: right

title: {
  label: "WASM Loading & Integrity"
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# --- Default: bundled in @fhevm/sdk ---
default: "Default — bundled in @fhevm/sdk" {
  style.fill: "#E8F5E9"
  style.stroke: "#388E3C"
  style.font-size: 14

  pkg: "TFHE WASM ships inside\nthe @fhevm/sdk npm package" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  bundle: "Loaded from your own bundle\n(no runtime CDN fetch)" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  lockfile: "Integrity via package-manager\nlockfile hashes + build pipeline" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }

  pkg -> bundle
  bundle -> lockfile
}

# --- wasmAssetLoadMode: how assets are fetched + instantiated ---
# Integrity is per-mode, not universal — trusted-direct-url skips verification.
modes: "wasmAssetLoadMode\n(auto picks the best available)" {
  style.fill: "#E3F2FD"
  style.stroke: "#1565C0"
  style.font-size: 14

  embedded: "embedded-base64\nWASM inlined as base64 —\nno network fetch" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  verified: "verified-blob\nFetch from URL, SHA-verify,\nfail init on mismatch" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  precheck: "precheck-direct-url\nPrecheck request, then\nload directly from the URL" {
    style.fill: "#BBDEFB"
    style.stroke: "#1565C0"
  }
  trusted: "trusted-direct-url\nLoad directly from the URL,\nno verification\n(fastest, least defensive)" {
    style.fill: "#FFE0B2"
    style.stroke: "#E65100"
  }
}

execute: "TFHE / ZK prover runs\nin the page (or worker pool)" {
  style.fill: "#E8F5E9"
  style.stroke: "#388E3C"
  style.font-size: 14
  style.bold: true
}

default -> execute: "execute" {
  style.stroke: "#388E3C"
}
modes.embedded -> execute {
  style.stroke: "#388E3C"
}
modes.verified -> execute {
  style.stroke: "#388E3C"
}
modes.precheck -> execute {
  style.stroke: "#1565C0"
}
modes.trusted -> execute {
  style.stroke: "#E65100"
}
