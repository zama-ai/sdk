# Upstream Ethereum RPC URL (required)
ZAMA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain ID — only Sepolia (11155111) is wired in this POC
ZAMA_CHAIN_ID=11155111

# HTTP server bind address / port / path
ZAMA_HOST=127.0.0.1
ZAMA_PORT=8545
ZAMA_HTTP_PATH=/

# ERC-7984 confidential token wired for auto-rewrite.
# Defaults to cUSDC on Sepolia (same token used by examples/react-wagmi's vault demo).
# ZAMA_CONFIDENTIAL_TOKEN=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639

# Zama relayer API key — optional on Sepolia testnet
# ZAMA_RELAYER_API_KEY=

# ZAMA_VERBOSE=true
# ZAMA_QUIET=true
