{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "tsBuildInfoFile": ".tsbuildinfo",
    // The NodeNext build cannot compile sdk source, so typecheck and build both resolve the sdk's dist.
    "customConditions": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
