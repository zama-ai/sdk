  "metadata": {
    "owner": "Zama",
    "contractName": "Zama Shield Underlying Token",
    "info": {
      "url": "https://www.zama.ai/"
    }
  },
  "display": {
    "formats": {
      "approve(address spender,uint256 amount)": {
        "intent": "Approve shield wrapper",
        "interpolatedIntent": "Approve {amount}",
        "fields": [
          {
            "path": "#.spender",
            "label": "Wrapper",
            "format": "addressName",
            "params": {
              "types": ["contract"]
            }
          },
          {
            "path": "#.amount",
            "label": "Approval amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          }
        ]
      },
      "transferAndCall(address to,uint256 value,bytes data)": {
        "intent": "Shield public tokens",
        "interpolatedIntent": "Shield {value} through {to}",
        "fields": [
          {
            "path": "#.to",
            "label": "Wrapper",
            "format": "addressName",
            "params": {
              "types": ["contract"]
            }
          },
          {
            "path": "#.value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "#.data",
            "label": "Recipient data",
            "format": "raw",
            "visible": "optional"
          }
        ]
      }
    }
  }
}
