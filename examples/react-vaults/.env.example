# The vault to show. Both batcher addresses are required.
NEXT_PUBLIC_DEPOSIT_BATCHER=
NEXT_PUBLIC_REDEEM_BATCHER=
# Block the batchers were deployed at. The batch list reads their events from here.
NEXT_PUBLIC_FROM_BLOCK=0

