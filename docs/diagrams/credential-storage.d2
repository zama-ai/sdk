direction: right

title: {
  label: "Transport Key Pair Storage"
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# --- Generation ---
gen: "SDK generates\nML-KEM key pair\n(client-side)" {
  style.fill: "#FFF3E0"
  style.stroke: "#E65100"
  style.font-size: 14
}

keypair: "Transport key pair\n(public + private)" {
  style.fill: "#FCE4EC"
  style.stroke: "#C62828"
  style.font-size: 14
  style.bold: true
}

# --- Persisted verbatim (no encryption-at-rest) ---
plaintext: "Persisted verbatim\n(plaintext — no\nencryption-at-rest layer)" {
  style.fill: "#FFCDD2"
  style.stroke: "#C62828"
  style.font-size: 14
}

storage: "Storage backend" {
  shape: cylinder
  style.fill: "#E8EAF6"
  style.stroke: "#283593"
  style.font-size: 14

  idb: "IndexedDB\n(browser)"
  mem: "Memory\n(tests)"
  als: "AsyncLocalStorage\n(Node.js)"
}

# --- Scope + protection ---
scope: "Scope\nOne key pair per signer address\nby default (chain-independent);\ntransportKeyPairScope shares one" {
  style.fill: "#E3F2FD"
  style.stroke: "#1565C0"
  style.font-size: 13
}

protect: "Protection\nSame-origin isolation\n(only same-origin JS can read\nIndexedDB — not encryption)" {
  style.fill: "#FFFDE7"
  style.stroke: "#F57F17"
  style.font-size: 13
}

# --- Connections ---
gen -> keypair
keypair -> plaintext: "store"
plaintext -> storage: "persisted"
storage -> scope: "keyed by signer" {
  style.stroke-dash: 5
}
storage -> protect: "guarded by" {
  style.stroke-dash: 5
}
