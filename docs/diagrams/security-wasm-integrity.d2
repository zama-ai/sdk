direction: right

title: {
  label: "WASM Loading & Integrity"
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# --- Default: bundled ---
default: "Default — bundled" {
  style.fill: "#E8F5E9"
  style.stroke: "#388E3C"
  style.font-size: 14

  pkg: "TFHE WASM ships inside\nthe @fhevm/sdk npm package" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  bundle: "Loaded from your own bundle\n(no runtime CDN fetch)" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }
  lockfile: "Integrity via package-manager\nlockfile hashes + build pipeline" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
  }

  pkg -> bundle
  bundle -> lockfile
}

# --- Optional: URL-hosted ---
optional: "Optional — URL-hosted (wasmAssetLoadMode / locateFile)" {
  style.fill: "#E3F2FD"
  style.stroke: "#1565C0"
  style.font-size: 14

  fetch: "Fetch WASM bytes\nfrom configured URL" {
    style.fill: "#BBDEFB"
    style.stroke: "#1565C0"
  }
  verify: "SHA-verify bytes against\nhash pinned in the library" {
    style.fill: "#F3E5F5"
    style.stroke: "#6A1B9A"
  }
  ok: "Execute WASM" {
    style.fill: "#C8E6C9"
    style.stroke: "#388E3C"
    style.bold: true
  }
  fail: "Fail initialization\n(no fallback)" {
    style.fill: "#FFCDD2"
    style.stroke: "#C62828"
    style.bold: true
  }

  fetch -> verify: "raw bytes"
  verify -> ok: "match" {
    style.stroke: "#388E3C"
  }
  verify -> fail: "mismatch" {
    style.stroke: "#C62828"
  }
}

default -> execute: "execute" {
  style.stroke: "#388E3C"
}
execute: "TFHE / ZK prover runs\nin the page (or worker pool)" {
  style.fill: "#E8F5E9"
  style.stroke: "#388E3C"
  style.font-size: 14
  style.bold: true
}
optional.ok -> execute {
  style.stroke: "#388E3C"
}
