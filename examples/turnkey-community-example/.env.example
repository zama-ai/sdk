# ── Chain ────────────────────────────────────────────────────────────────────
# "sepolia" (default) or "mainnet"
# Switching to "mainnet" automatically selects the correct Zama contract
# addresses, relayer URL, and token registry — no other code change required.
NEXT_PUBLIC_CHAIN=sepolia

# ── Turnkey ─────────────────────────────────────────────────────────────────
# Your Turnkey organization ID (public — safe for NEXT_PUBLIC_)
NEXT_PUBLIC_TURNKEY_ORG_ID=your-org-id-here

# Turnkey Auth Proxy Config ID used by @turnkey/react-wallet-kit
# Make sure the linked Auth Proxy is enabled in Turnkey Wallet Kit settings.
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=your-auth-proxy-config-id-here

# ── RPC ───────────────────────────────────────────────────────────────────────
# Recommended: Alchemy free tier (handles the large eth_call batches used by the Zama SDK).
# If unset, falls back to the public node bundled in the Zama SDK for the selected chain.
# Sepolia:  https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Mainnet:  https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Zama Relayer ─────────────────────────────────────────────────────────────
# Not required on Sepolia testnet (public relayer, no auth).
# Likely required on mainnet — obtain from Zama.
# ZAMA_RELAYER_API_KEY=your-relayer-api-key
